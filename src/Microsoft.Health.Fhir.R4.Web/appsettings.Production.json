      "EnableAadSmartOnFhirProxy": false,
      "Authentication": {
        "RequireHttpsMetadata": true  
      }
    },

    "Cors": {
       "Origins": [
        "https://e-likita-staging-dbetfddtbfdydudm.canadacentral-01.azurewebsites.net",
        "http://localhost:4200","dev-auth-server-fmd4dthndrhjdzf2.canadacentral-01.azurewebsites.net"
      ],
      "Methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS", "PATCH", "HEAD"],
